# Checkpoint allowlist is staged explicitly. Everything else stays local.
/*
!/.gitignore
!/.github/
!/.github/workflows/
!/.github/workflows/**
!/work/
/work/*
!/work/veil-core-review/
!/work/veil-devnet/
/work/veil-core-review/*
!/work/veil-core-review/tamassol_veil_router_v3/
!/outputs/
/outputs/*
!/outputs/tamassol/
**/node_modules/
**/.env
**/.env.*
**/secrets/
**/private-wallets/
**/private-link/
**/voice-transfer-state/
**/.pio/
**/__pycache__/
**/*.pyc
**/*.log
**/*.lock
**/*.bin
**/*-evidence/
**/checks.jsonl
**/include/OnlineConfig.h
