# Checkpoint allowlist is staged explicitly. Everything else stays local.
/*
!/.gitignore
!/README.md
!/README.pt-BR.md
!/docs/
/docs/*
!/docs/brand/
/docs/brand/*
!/docs/brand/universe.webp
!/docs/brand/solflame.webp
!/docs/brand/frost.webp
!/docs/brand/volt.webp
!/docs/brand/mizu.webp
!/docs/brand/verdant.webp
!/docs/brand/void.webp
!/work/
/work/*
!/work/veil-core-review/
!/work/veil-devnet/
/work/veil-core-review/*
!/work/veil-core-review/tamassol_veil_router_v3/
!/outputs/
/outputs/*
!/outputs/tamassol/
**/node_modules/
**/.env
**/.env.*
**/secrets/
**/private-wallets/
**/private-link/
**/voice-transfer-state/
**/.pio/
**/__pycache__/
**/*.pyc
**/*.log
**/*.lock
**/*.bin
**/*-evidence/
**/checks.jsonl
**/include/OnlineConfig.h
